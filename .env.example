# Domains (nginx -> host port)
# auth.kayas.dev   -> 8181
# panel.kayas.dev  -> 3101
AUTH_API_HOST_PORT=8181
AUTH_FRONTEND_HOST_PORT=3101

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=AuthServerDb

# Auth API
JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_ISSUER=https://auth.kayas.dev
JWT_AUDIENCE=https://auth.kayas.dev
SEED_ADMIN_PASSWORD=change-me-super-admin-password

# ECommerce entegrasyonu (modular-saas-ecommerce .env ile ayni token)
ECOMMERCE_API_BASE_URL=https://api.kayas.dev
ECOMMERCE_SERVICE_TOKEN=change-me-same-as-ecommerce-ecOMMERCE_SERVICE_TOKEN

# Frontend build
VITE_API_BASE_URL=https://auth.kayas.dev/api/v1
AUTH_FRONTEND_PATH=../AuthService-Frontend

# Email (opsiyonel)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
